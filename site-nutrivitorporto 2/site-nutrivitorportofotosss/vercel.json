{
  "routes": [
    {
      "src": "/capas/(.*)",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "/",
      "dest": "/atualizacao-resultados/index.html"
    },
    {
      "src": "/index.html",
      "dest": "/atualizacao-resultados/index.html"
    },
    {
      "src": "/resultados/(.*)",
      "dest": "/atualizacao-resultados/resultados/$1"
    }
  ]
}
